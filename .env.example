# Copy this file to .env and fill in values for local development.
# .env is git-ignored — never commit real credentials.

# Runtime environment. Controls log formatting (pretty vs JSON) and other
# environment-specific behavior. One of: development | production | test
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000

# PostgreSQL connection string, format: postgres://user:password@host:port/db
# Matches the credentials/port defined in docker-compose.yml.
DATABASE_URL=postgres://clickscope:clickscope@localhost:5432/clickscope

# Redis connection string, format: redis://host:port
# Matches the port defined in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Minimum severity Pino will emit. One of:
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated list of origins allowed to make cross-origin requests
# (the frontend's dev server, plus any deployed preview URLs). Must not be
# "*" — list explicit origins only.
CORS_ORIGIN=http://localhost:5173
