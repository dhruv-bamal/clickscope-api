# Copy this file to .env and fill in values for local development.
# .env is git-ignored — never commit real credentials.

# Runtime environment. Controls log formatting (pretty vs JSON) and other
# environment-specific behavior. One of: development | production | test
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000

# PostgreSQL connection string, format: postgres://user:password@host:port/db
# Matches the credentials/port defined in docker-compose.yml.
DATABASE_URL=postgres://clickscope:clickscope@localhost:5432/clickscope

# Redis connection string, format: redis://host:port
# Matches the port defined in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Minimum severity Pino will emit. One of:
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated list of origins allowed to make cross-origin requests
# (the frontend's dev server, plus any deployed preview URLs). Must not be
# "*" — list explicit origins only.
CORS_ORIGIN=http://localhost:5173

# Signs and verifies JWTs. Required, at least 32 characters, no default —
# a weak or leaked secret lets an attacker forge valid tokens for any user.
# Generate your own with `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long

# How long an issued token stays valid before the client must sign in again.
JWT_EXPIRES_IN=7d

# bcrypt work factor: each increment roughly doubles hashing time.
# 12 is a reasonable 2024+ default (~200-300ms/hash on typical hardware).
BCRYPT_COST=12

# Google OAuth 2.0 client ID, from Google Cloud Console's "OAuth 2.0
# Client IDs" for this project. Required, no default.
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com

# Paired secret for GOOGLE_CLIENT_ID. Authenticates this server (not the
# browser) to Google's token endpoint during code exchange. Required, no
# default — never expose this to the browser or commit a real value.
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# Must exactly match a redirect URI registered for this client in Google
# Cloud Console, or Google rejects the code exchange.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Where the OAuth callback redirects the browser after login (success,
# denial, or rejection), carrying the issued JWT as a query parameter.
FRONTEND_URL=http://localhost:5173
