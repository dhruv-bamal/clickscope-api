{
  "name": "clickscope-api",
  "version": "0.1.0",
  "description": "Click Scope: URL shortening service with link analytics — standalone Express REST API.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "migrate:up": "node --env-file=.env node_modules/.bin/node-pg-migrate up",
    "migrate:down": "node --env-file=.env node_modules/.bin/node-pg-migrate down",
    "migrate:create": "node --env-file=.env node_modules/.bin/node-pg-migrate create -j ts --migration-filename-format utc",
    "seed": "tsx --env-file=.env scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.2"
  }
}
