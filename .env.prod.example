# Copy this file to .env.prod for validating the built images locally via
# docker-compose.prod.yml. .env.prod is git-ignored, same as .env.
#
# This is NOT a real production secrets file — docker-compose.prod.yml
# exists to prove the Docker images build/run/talk to each other, not to
# simulate real production infrastructure (no secrets manager, no TLS,
# no orchestrator). Real deployment env vars are Phase 15c's concern.
#
# DATABASE_URL/REDIS_URL use the compose service names (postgres, redis)
# as hostnames, not localhost — containers on the same compose network
# resolve each other by service name, not by the host's loopback address.
#
# NODE_ENV must stay "production" here — it is not just what a real
# deploy would use, it's the ONLY value this image can run with. The
# runtime stage installs with `npm ci --omit=dev`, so pino-pretty (used
# only when NODE_ENV === 'development', see src/lib/logger.ts) isn't in
# the image at all; setting NODE_ENV=development against this image
# crashes it on boot with "unable to determine transport target for
# pino-pretty" (confirmed while validating this file).
#
# One known, expected consequence: src/db/pool.ts and worker/db/pool.ts
# both force `ssl: { rejectUnauthorized: true }` when NODE_ENV ===
# 'production', since the real deploy target (Supabase) requires SSL.
# This compose file's local postgres:16 container has no SSL listener at
# all (same as the dev docker-compose.yml), so GET /health will
# correctly report 503 (database check fails) against it, and the
# worker's link-cleanup job will correctly fail with "The server does
# not support SSL connections" — that's the SSL enforcement working
# exactly as designed, not a bug in this compose stack. It confirms the
# containers build, start, bind their ports, and shut down cleanly;
# full DB-backed health validation needs DATABASE_URL pointed at a real
# SSL-capable Postgres instead of the local one.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://clickscope:clickscope@postgres:5432/clickscope
REDIS_URL=redis://redis:6379

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Same 32-char-minimum requirement as .env.example. Generate your own with
# `openssl rand -base64 48` — this only needs to satisfy env.ts's schema
# for local image validation, not be a real secret.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# Dummy values are fine here too — this compose stack never exercises a
# real Google OAuth round trip, it's only validating that the api
# container starts, connects to postgres/redis, and serves /health.
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

TRUST_PROXY=0

RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_UNLOCK_WINDOW_SECONDS=60
RATE_LIMIT_UNLOCK_MAX=5
RATE_LIMIT_LINKS_WINDOW_SECONDS=60
RATE_LIMIT_LINKS_MAX=20

# Optional — leave unset (or blank, as below) to disable error tracking.
# env.ts normalizes an empty string to "unset" for this field specifically
# (see Notes.md, "Phase 15a" / "Empty string vs. absent: the --env-file
# trap") — both Node's --env-file and Docker Compose's env_file: parse a
# bare `SENTRY_DSN=` line as an empty string, not an absent variable, and
# that's now handled explicitly rather than crashing the container.
SENTRY_DSN=
