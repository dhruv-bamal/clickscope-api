# Copy this file to .env.test for running the integration test suite.
# .env.test is git-ignored, same as .env.
#
# Points at a dedicated clickscope_test database on the same local Docker
# Postgres used for dev — tests/globalSetup.ts creates this database and
# applies migrations to it automatically, so the dev database in .env is
# never touched by `npm test`.
NODE_ENV=test
PORT=3000
DATABASE_URL=postgres://clickscope:clickscope@localhost:5432/clickscope_test
REDIS_URL=redis://localhost:6379
LOG_LEVEL=warn
CORS_ORIGIN=http://localhost:3000

# Fixed test-only secret — not sensitive, just needs to satisfy the 32-char
# minimum. Determinism matters more than secrecy for a disposable test DB.
JWT_SECRET=test-only-jwt-secret-value-not-for-production-use
JWT_EXPIRES_IN=7d

# Low cost so the test suite (many hash/compare calls across signup/login/
# dummy-hash paths) stays fast. Production uses 12.
BCRYPT_COST=4

# Dummy values — the test suite never calls the real Google API (the token
# exchange is intercepted with nock, verifyIdToken is stubbed), so these
# only need to satisfy env.ts's schema (non-empty strings / valid URLs).
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
